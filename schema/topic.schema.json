{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://top10everything.example/schema/topic.schema.json",
  "title": "Top 10 Everything topic",
  "description": "One rankable topic record. Every field is required unless marked optional; unknown values must be stated honestly rather than guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "parent_id",
    "parent_name",
    "path",
    "level",
    "subcategories",
    "subcategory_count",
    "geographic_coverage",
    "sources",
    "ranking_method",
    "update_frequency",
    "data_availability",
    "research_status",
    "licensing_risk",
    "notes",
    "schema_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$",
      "description": "Stable identifier: <category-id>.<topic-slug>."
    },
    "name": { "type": "string", "minLength": 1 },
    "parent_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Category id."
    },
    "parent_name": { "type": "string", "minLength": 1 },
    "path": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "description": "Human-readable breadcrumb: [category name, topic name]."
    },
    "level": { "type": "integer", "const": 2 },
    "subcategories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Suggested facets for the ranking. These are editorial splits, not separate catalogued topics."
    },
    "subcategory_count": { "type": "integer", "minimum": 1 },
    "geographic_coverage": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Scope codes such as global, europe, united-states, or a region name."
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "backup", "primary_count", "backup_count", "independent_source_coverage"],
      "properties": {
        "primary": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "backup": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "primary_count": { "type": "integer", "minimum": 0 },
        "backup_count": { "type": "integer", "minimum": 0 },
        "independent_source_coverage": {
          "type": "boolean",
          "description": "True when at least two distinct sources are available in total."
        }
      }
    },
    "ranking_method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "question",
        "metric",
        "basis",
        "subjectivity",
        "human_verification_required"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "question": {
          "type": "string",
          "minLength": 10,
          "description": "The exact question the ranking answers, including the metric and any proxy caveat."
        },
        "metric": { "type": "string", "minLength": 1 },
        "basis": {
          "type": "string",
          "enum": [
            "objective_statistic",
            "expert_index",
            "bibliometric",
            "official_result",
            "user_rating",
            "proxy_attention",
            "proxy_activity",
            "market_data",
            "objective_measurement",
            "editorial",
            "survey",
            "official_record"
          ]
        },
        "subjectivity": {
          "type": "string",
          "enum": ["objective", "subjective", "mixed", "proxy"]
        },
        "human_verification_required": { "type": "boolean" }
      }
    },
    "update_frequency": {
      "type": "string",
      "enum": ["event", "daily", "weekly", "monthly", "quarterly", "yearly"]
    },
    "data_availability": {
      "type": "string",
      "enum": ["strong", "moderate", "limited", "none"],
      "description": "strength: ready for automated ingestion. moderate: usable with caveats. limited: partial or proxy data. none: no responsible free source identified."
    },
    "research_status": {
      "type": "string",
      "enum": ["researched", "researched_proxy", "partial", "unsupported"],
      "description": "researched: source and method identified. researched_proxy: only attention/canon proxies. partial: gaps remain. unsupported: cannot be built from free data."
    },
    "licensing_risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown"]
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Honest caveats. Never empty when the ranking is a proxy or the licence is restricted."
    },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "access_model", "commercial_use", "attribution_required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "access_model": {
          "type": "string",
          "enum": ["open", "free_tier", "free_key", "free_account", "restricted", "paid"]
        },
        "commercial_use": {
          "type": "string",
          "enum": ["allowed", "allowed_with_conditions", "prohibited", "unclear", "varies"]
        },
        "attribution_required": {
          "type": ["boolean", "null"],
          "description": "null when attribution depends on the individual dataset or record."
        }
      }
    }
  }
}
