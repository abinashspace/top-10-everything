{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://top10everything.example/schema/source.schema.json",
  "title": "Top 10 Everything data source",
  "description": "A catalogued data source. Licence and access fields describe what the provider states, not legal advice, and must be re-checked before commercial use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "organization",
    "official_url",
    "api_docs_url",
    "api_base_url",
    "coverage_categories",
    "data_types",
    "access",
    "license",
    "bulk_download",
    "update_frequency",
    "operational",
    "verification",
    "reference_only",
    "caveats",
    "usage"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name": { "type": "string", "minLength": 1 },
    "organization": { "type": "string", "minLength": 1 },
    "official_url": { "type": "string", "format": "uri" },
    "api_docs_url": { "type": ["string", "null"], "format": "uri" },
    "api_base_url": { "type": ["string", "null"], "format": "uri" },
    "coverage_categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "data_types": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "authentication", "key_url", "limits_summary", "limits_url"],
      "properties": {
        "model": {
          "type": "string",
          "enum": ["open", "free_tier", "free_key", "free_account", "restricted", "paid"]
        },
        "authentication": {
          "type": ["string", "null"],
          "enum": ["none", "api_key", "oauth", "account", "email", "unknown", null]
        },
        "key_url": { "type": ["string", "null"] },
        "limits_summary": {
          "type": "string",
          "minLength": 1,
          "description": "Free-tier limits as stated by the provider. Say 'verify' when the limit is not published or may change."
        },
        "limits_url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "commercial_use", "attribution_required", "share_alike", "redistribution"],
      "properties": {
        "name": {
          "type": ["string", "null"],
          "description": "Licence name, or null when it could not be established."
        },
        "url": { "type": ["string", "null"], "format": "uri" },
        "commercial_use": {
          "type": "string",
          "enum": ["allowed", "allowed_with_conditions", "prohibited", "unclear", "varies"],
          "description": "Conservative assessment. Use 'unclear' or 'varies' instead of assuming permission."
        },
        "attribution_required": { "type": ["boolean", "null"] },
        "share_alike": { "type": ["boolean", "null"] },
        "redistribution": {
          "type": ["string", "null"],
          "description": "Free-text summary of redistribution rules."
        }
      }
    },
    "bulk_download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "url"],
      "properties": {
        "available": { "type": "boolean" },
        "url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "update_frequency": { "type": "string", "minLength": 1 },
    "operational": {
      "type": "boolean",
      "description": "True when the last check produced a response that proves the provider is reachable (ok, auth_required, forbidden or rate_limited)."
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_url", "last_checked", "method", "result"],
      "properties": {
        "test_url": { "type": ["string", "null"] },
        "last_checked": { "type": ["string", "null"] },
        "method": { "type": "string", "enum": ["live_http_get", "manual"] },
        "test_scope": {
          "type": "string",
          "enum": ["endpoint", "website_or_docs"]
        },
        "http_status": { "type": ["integer", "null"] },
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "auth_required",
            "forbidden",
            "rate_limited",
            "http_error",
            "network_error",
            "no_test_url",
            "not_checked"
          ]
        },
        "final_url": { "type": ["string", "null"] },
        "elapsed_ms": { "type": ["integer", "null"] },
        "notes": { "type": "string" }
      }
    },
    "reference_only": {
      "type": "boolean",
      "description": "True for proprietary or editorial benchmarks that may inform a methodology but cannot be redistributed."
    },
    "caveats": {
      "type": "array",
      "items": { "type": "string" }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_for_topics", "backup_for_topics", "primary_for_count", "backup_for_count"],
      "properties": {
        "primary_for_topics": { "type": "array", "items": { "type": "string" } },
        "backup_for_topics": { "type": "array", "items": { "type": "string" } },
        "primary_for_count": { "type": "integer", "minimum": 0 },
        "backup_for_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
